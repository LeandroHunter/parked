{
  "name": "parked",
  "version": "1.0.0",
  "private": true,
  "description": "Parked — remember where you parked and get guided back to your car.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts && node scripts/serve.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.0.0",
    "geomagnetism": "^0.2.0",
    "typescript": "^5.6.0"
  }
}
